{% extends '@OpenConextProfile/layout.html.twig' %}

{% block title %}
    {{ 'profile.my_profile.short_title'|trans }} &mdash; {{ parent() }}
{% endblock %}

{% block contentClasses %}
    content__myProfile
{% endblock %}

{% block content %}
    <h1 class="content__title">{{ 'profile.my_profile.short_title'|trans }}</h1>
    <p class="myProfile__intro">{{ 'profile.my_profile.introduction'|trans }} <a href="{{ global_view_parameters.attributeInformationUrl }}">{{ 'profile.my_profile.attributes_information_link_title'|trans }}</a>.</p>

    {% include "@OpenConextProfile/MyProfile/attributes-table.html.twig" %}

    {% if user.hasSupportContactEmail %}
        {% set supportContactEmail = user.supportContactEmail|replace({'mailto:': ''}) %}
        {% set text %}
            <sup>*</sup> {{ 'profile.my_profile.questions'|trans }} <a href="mailto:{{ supportContactEmail }}">{{ supportContactEmail }}</a>.
        {% endset %}
    {% else %}
        {% set text %}
            <sup>*</sup> {{ 'profile.my_profile.questions_no_support_contact_email'|trans }}
        {% endset %}
    {% endif %}

    {% include "@OpenConextProfile/helpers/paragraph-note.html.twig" with {
        className: 'myProfile__note',
        text: text
    } %}

    <section class="myProfile__section myProfile__wayfReset">
        <h2 class="title__emphasis">{{ 'profile.my_profile.wayf_reset.title'|trans }}</h2>
        <div class="myProfile__wayfResetExplanation">
            <p class="myProfile__wayfResetText">{{ 'profile.my_profile.wayf_reset.explanation'|trans }}</p>
            <div class="myProfile__wayfResetButtonWrapper">
                {% set modalContent %}
                    <p id="wayf-reset-description">{{ 'profile.my_profile.wayf_reset.modal_explanation'|trans }}</p>
                {% endset %}

                {% set buttonRowContent %}
                    <a href="{{ wayfResetLink }}" class="button modalWindow__button">
                        {{ 'profile.my_profile.wayf_reset.confirm_button'|trans }}
                    </a>
                {% endset %}

                {# The modal helper presupposes a `for` loop context (it derives its element
                   ids from `loop.index`); wrap it in a single-iteration loop since this page
                   only ever shows one reset link. #}
                {% for _ in [1] %}
                    {% include "@OpenConextProfile/helpers/modal.html.twig" with {
                        buttonText: 'profile.my_profile.wayf_reset.link_text'|trans,
                        linkIdPrefix: 'wayf_reset_',
                        buttonClass: 'modalWindowButton myProfile__wayfResetButton',
                        describedBy: 'wayf-reset-description',
                        modalHeader: 'profile.my_profile.wayf_reset.modal_title'|trans,
                        modalContent: modalContent,
                        buttonRowContent: buttonRowContent,
                    } %}
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
