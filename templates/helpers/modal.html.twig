{# This code presupposes a loop #}
{% if linkId is not defined %}
    {% set linkId = linkIdPrefix ~ loop.index %}
{% endif %}
{# Derive headerId from linkId (always unique) rather than loop.index, so that
   multiple modal instances rendered outside of a real iteration (e.g. two
   independent modals on the same page) don't end up with duplicate ids. #}
{% set headerId = 'dialog-header-' ~ linkId %}

<a
    class="button__secondary--white {{ buttonClass }}"
    data-id="{{ linkId }}"
    href="#{{ linkId }}"
    role="button"
    {% if buttonDescription is defined %} aria-describedBy="{{ buttonDescription }}"{% endif %}
    {% if autoOpen is defined and autoOpen %} data-auto-open="true" tabindex="-1"{% endif %}
    {% if cleanParam is defined %} data-clean-param="{{ cleanParam }}"{% endif %}
>
    {{ buttonText }}
</a>

<div
    class="modalWindow"
    id="{{ linkId }}"
    role="alertdialog"
    aria-modal="true"
    aria-labelledby="{{ headerId }}"
    aria-describedby="{{ describedBy }}"
>
    <div class="modalWindow__content">
        <h4
            class="modalWindow__header"
            id="{{ headerId }}"
        >{{ modalHeader }}</h4>
        <div class="modalWindow__main">
            {{ modalContent }}
            <div class="modalWindow__buttonRow{% if buttonRowContent is not defined or buttonRowContent|trim is empty %} modalWindow__buttonRow--single{% endif %}">
                <a href="#ok" class="button button__secondary--white modalWindow__button modalWindow__cancel"  data-to={{ linkId }}>{{ cancelButtonText|default('general.cancel'|trans) }}</a>
                {{ buttonRowContent }}
            </div>
        </div>
    </div>
</div>
